{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Task AI Platform",
  "version": "0.1.36",
  "identifier": "dev.taskai.platform",
  "build": {
    "beforeDevCommand": {
      "script": "concurrently \"pnpm run backend:dev:watch\" \"pnpm run local-web:dev\"",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:3000",
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://localhost:* http://127.0.0.1:*; connect-src 'self' http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Provider-independent AI task workspace",
    "longDescription": "Task AI Platform: task-centred execution and handoff across interchangeable AI providers",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyN0ZCNDVCMDhFMDdEQjAKUldTd2ZlQUlXN1IvTWt1Z0ZmaWpsUUVGOHl3QUExRVVWL0crWkROSjViRUZSTXdUODN4WkFlQ1AK",
      "endpoints": ["__TAURI_UPDATE_ENDPOINT__"]
    }
  }
}
